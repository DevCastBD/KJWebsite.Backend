{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "SiteOrigins": [],
    "AdminOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "SlidingSegments": 6,
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "CtaSubmission": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "MembershipIntake": {
      "PermitLimit": 20,
      "WindowSeconds": 3600
    },
    "MembershipStatus": {
      "PermitLimit": 10,
      "WindowSeconds": 900
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "TrustAnyProxy": false
  }
}
