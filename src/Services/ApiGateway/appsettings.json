{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "SiteOrigins": [],
    "AdminOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "SlidingSegments": 6,
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "CtaSubmission": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "TrustAnyProxy": false
  },
  "ReverseProxy": {
    "Routes": {
      "content": {
        "ClusterId": "content",
        "Match": {
          "Path": "/api/v1/content/{**catch-all}"
        }
      },
      "cta": {
        "ClusterId": "cta",
        "Match": {
          "Path": "/api/v1/cta/{**catch-all}"
        }
      },
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "admin-content": {
        "ClusterId": "content",
        "Match": {
          "Path": "/api/v1/admin/content/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "content": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        }
      },
      "cta": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        }
      },
      "auth": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        }
      }
    }
  }
}
